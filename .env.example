# --- Core ---
DEMO_MODE=true
ENVIRONMENT=development

# --- Database ---
DATABASE_URL=postgresql+psycopg://gci:gci@localhost:5432/gci

# --- GDACS (no key required for public endpoints) ---
GDACS_BASE_URL=https://www.gdacs.org/gdacsapi/api
GDACS_POLL_SECONDS=600

# --- GDELT Cloud v2 (https://docs.gdeltcloud.com/api-reference/v2) ---
GDELT_CLOUD_BASE_URL=https://api.gdeltcloud.com
GDELT_CLOUD_API_KEY=
GDELT_POLL_SECONDS=900

# --- AI Intelligence Analyst (Anthropic) ---
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000

# --- Cache ---
CACHE_TTL_SECONDS=300

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
